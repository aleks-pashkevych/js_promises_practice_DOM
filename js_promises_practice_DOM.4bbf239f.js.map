'use strict';
var div = document.createElement('div');
var firstPromise = new Promise(function(resolve, reject) {
    var timeOut = setTimeout(function() {
        reject(new Error("First promise was rejected"));
    }, 3000);
    document.addEventListener('click', function() {
        resolve("First promise was resolved");
        clearTimeout(timeOut);
    });
});
var secondPromise = new Promise(function(resolve, reject) {
    document.addEventListener('mousedown', function(e) {
        if (e.button === 0 || e.button === 2) resolve("Second promise was resolved");
    });
});
var thirdPromise = new Promise(function(resolve, reject) {
    var leftBtn = false;
    var rightBtn = false;
    document.addEventListener('mousedown', function(e) {
        if (e.button === 0) leftBtn = true;
        if (e.button === 2) rightBtn = true;
        if (leftBtn === true && rightBtn === true) resolve('Third promise was resolved');
    });
});
firstPromise.then(function(message) {
    div.setAttribute('data-qa', 'notification');
    div.classList.add('success');
    div.classList.remove('error');
    div.textContent = message;
    document.body.appendChild(div);
}).catch(function(error) {
    div.setAttribute('data-qa', 'notification');
    div.classList.add('error');
    div.classList.remove('success');
    div.textContent = error.message;
    document.body.appendChild(div);
});
